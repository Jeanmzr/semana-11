def validar(num, f, c):
    for k in range(9):
        if mat[f][k] == num:     
            return False
        if mat[k][c] == num:     
            return False

    f0 = f // 3 * 3               
    c0 = c // 3 * 3
    for a in range(f0, f0 + 3):
        for b in range(c0, c0 + 3):
            if mat[a][b] == num:  
                return False
    return True


